{
    "name": "university/course-portal",
    "description": "University Course Portal built with Slim 4",
    "type": "project",
    "require": {
        "php": ">=8.0",
        "slim/slim": "^4.12",
        "slim/psr7": "^1.6",
        "php-di/php-di": "^7.0",
        "illuminate/database": "^10.0",
        "vlucas/phpdotenv": "^5.5",
        "slim/flash": "^0.4",
        "slim/twig-view": "^3.3",
        "phpmailer/phpmailer": "^7.1"
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "config": {
        "vendor-dir": "vendor"
    }
}
