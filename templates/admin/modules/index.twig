{# templates/admin/modules/index.twig #}
{% extends "admin/base.twig" %}
{% set page = 'modules' %}
{% block title %}Modules{% endblock %}
{% block page_title %}Modules{% endblock %}

{% block content %}
<div class="box">
  <div class="box-header">
    <h2>All Modules</h2>
    <a href="/university_course_portal/public/admin/modules/create" class="btn btn-gold">+ New Module</a>
  </div>
  <table>
    <thead>
      <tr><th>Title</th><th>Code</th><th>Credits</th><th>Leader</th><th>Actions</th></tr>
    </thead>
    <tbody>
      {% for m in modules %}
      <tr>
        <td><strong>{{ m.title }}</strong></td>
        <td><span class="badge badge-gray">{{ m.code }}</span></td>
        <td>{{ m.credits }}</td>
        <td>{{ m.leader ? m.leader.name : '—' }}</td>
        <td style="display:flex;gap:.5rem">
          <a href="/university_course_portal/public/admin/modules/{{ m.id }}/edit" class="btn btn-muted btn-sm">Edit</a>
          <form method="post" action="/university_course_portal/public/admin/modules/{{ m.id }}/delete" onsubmit="return confirm('Delete this module?')">
            <button class="btn btn-danger btn-sm">Delete</button>
          </form>
        </td>
      </tr>
      {% else %}
      <tr><td colspan="5" style="text-align:center;color:#94a3b8;padding:1.5rem">No modules yet.</td></tr>
      {% endfor %}
    </tbody>
  </table>
</div>
{% endblock %}
