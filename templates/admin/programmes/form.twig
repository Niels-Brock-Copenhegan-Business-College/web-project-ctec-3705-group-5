{% extends "admin/base.twig" %}
{% set page = 'programmes' %}
{% block title %}{{ programme ? 'Edit' : 'New' }} Programme{% endblock %}
{% block page_title %}{{ programme ? 'Edit Programme' : 'New Programme' }}{% endblock %}

{% block extra_css %}
<style>
  .form-section { margin-bottom:1.5rem; }
  .form-section-title {
    font-size:.7rem;
    font-weight:700;
    text-transform:uppercase;
    letter-spacing:.12em;
    color:var(--muted);
    padding-bottom:.6rem;
    border-bottom:1px solid var(--border);
    margin-bottom:1.1rem;
  }
  .module-table { width:100%; border-collapse:collapse; font-size:.85rem; }
  .module-table thead th {
    padding:.6rem 1rem;
    text-align:left;
    background:#f8f9fa;
    font-size:.68rem;
    font-weight:700;
    text-transform:uppercase;
    letter-spacing:.09em;
    color:var(--muted);
    border-bottom:2px solid var(--border);
  }
  .module-table tbody tr { border-bottom:1px solid var(--border); transition:background .15s; }
  .module-table tbody tr:last-child { border-bottom:none; }
  .module-table tbody tr:hover { background:#fafbfc; }
  .module-table td { padding:.75rem 1rem; vertical-align:middle; }
  .module-table td label { cursor:pointer; font-weight:500; color:var(--navy); }
  .year-select {
    height:32px;
    padding:0 .65rem;
    font-size:.8rem;
    border:1.5px solid var(--border);
    border-radius:4px;
    font-family:inherit;
    color:var(--navy);
    background:var(--white);
    outline:none;
    transition:border-color .2s;
  }
  .year-select:focus { border-color:var(--gold); }
  .file-input {
    display:block;
    width:100%;
    padding:.5rem .75rem;
    border:1.5px solid var(--border);
    border-radius:5px;
    font-size:.82rem;
    font-family:inherit;
    background:var(--white);
    color:var(--navy);
    cursor:pointer;
  }
  .current-image-box {
    display:flex;
    gap:1rem;
    align-items:flex-start;
    padding:1rem;
    background:#f8f9fa;
    border:1px solid var(--border);
    border-radius:6px;
    margin-bottom:.85rem;
  }
  .current-image-box img { width:140px; height:80px; object-fit:cover; border-radius:4px; flex-shrink:0; }
  .current-image-box .img-info p { font-size:.8rem; color:var(--muted); margin:0 0 .5rem; }
  .remove-img-label { display:inline-flex; align-items:center; gap:.4rem; font-size:.78rem; color:#b91c1c; cursor:pointer; font-weight:600; }
  .form-footer {
    display:flex;
    gap:.75rem;
    align-items:center;
    padding-top:1.25rem;
    border-top:1px solid var(--border);
    margin-top:1.75rem;
  }
</style>
{% endblock %}

{% block content %}
<div style="max-width:860px">
  <div class="box">
    <div class="box-header">
      <h2>{{ programme ? 'Update Programme Details' : 'New Programme' }}</h2>
    </div>

    <div style="padding:1.75rem 1.5rem">
      <form method="post"
            action="{{ programme ? '/university_course_portal/public/admin/programmes/' ~ programme.id : '/university_course_portal/public/admin/programmes' }}"
            enctype="multipart/form-data">

        {# ── Basic Details ── #}
        <div class="form-section">
          <div class="form-section-title">Basic Details</div>

          <div class="form-group">
            <label for="title">Programme Title *</label>
            <input id="title" type="text" name="title"
                   value="{{ programme.title ?? '' }}"
                   placeholder="e.g. BSc Computer Science"
                   required autofocus>
          </div>

          <div class="form-row">
            <div class="form-group">
              <label for="level">Level *</label>
              <select id="level" name="level" required>
                <option value="Undergraduate" {{ (programme.level ?? 'Undergraduate') == 'Undergraduate' ? 'selected' : '' }}>Undergraduate</option>
                <option value="Postgraduate"  {{ (programme.level ?? '') == 'Postgraduate' ? 'selected' : '' }}>Postgraduate</option>
              </select>
            </div>
            <div class="form-group">
              <label for="duration_years">Duration (Years) *</label>
              <input id="duration_years" type="number" name="duration_years"
                     value="{{ programme.duration_years ?? 3 }}"
                     min="1" max="6" required>
            </div>
          </div>

          <div class="form-row">
            <div class="form-group">
              <label for="leader_id">Programme Leader</label>
              <select id="leader_id" name="leader_id">
                <option value="">— No Leader Assigned —</option>
                {% for s in staffList %}
                  <option value="{{ s.id }}" {{ (programme.leader_id ?? '') == s.id ? 'selected' : '' }}>
                    {{ s.name }}
                  </option>
                {% endfor %}
              </select>
            </div>
            <div class="form-group" style="display:flex;flex-direction:column;justify-content:flex-end">
              <div class="form-check" style="margin-bottom:0;padding-bottom:.65rem">
                <input id="is_published" type="checkbox" name="is_published"
                       {{ (programme.is_published ?? 0) ? 'checked' : '' }}>
                <label for="is_published" style="font-weight:500;text-transform:none;letter-spacing:0;font-size:.875rem">
                  Published <span style="color:var(--muted);font-size:.8rem">(visible to students)</span>
                </label>
              </div>
            </div>
          </div>

          <div class="form-group">
            <label for="description">Description</label>
            <textarea id="description" name="description" rows="4"
                      placeholder="A clear overview of what this programme covers, career outcomes, and entry requirements...">{{ programme.description ?? '' }}</textarea>
          </div>
        </div>

        {# ── Programme Image ── #}
        <div class="form-section">
          <div class="form-section-title">Programme Image</div>

          {% if programme and programme.image %}
            <div class="current-image-box">
              <img src="/university_course_portal/public/{{ programme.image }}" alt="Current programme image">
              <div class="img-info">
                <p>Current image. Upload a new file below to replace it.</p>
                <label class="remove-img-label">
                  <input type="checkbox" name="remove_image" value="1" style="width:auto;margin:0">
                  Remove current image
                </label>
              </div>
            </div>
          {% endif %}

          <input type="file" name="image" class="file-input"
                 accept="image/jpeg,image/png,image/webp">
          <p style="font-size:.75rem;color:var(--muted);margin-top:.4rem">
            Accepted formats: JPG, PNG, WEBP. Recommended size: 1200×600px. Max 2MB.
          </p>
        </div>

        {# ── Assign Modules ── #}
        <div class="form-section">
          <div class="form-section-title">Assign Modules</div>

          {% if modules|length == 0 %}
            <p style="color:var(--muted);font-size:.875rem">
              No modules available. <a href="/university_course_portal/public/admin/modules/create">Create a module first.</a>
            </p>
          {% else %}
            <div style="border:1px solid var(--border);border-radius:6px;overflow:hidden">
              <table class="module-table">
                <thead>
                  <tr>
                    <th style="width:50px;text-align:center">Include</th>
                    <th>Module</th>
                    <th>Code</th>
                    <th>Credits</th>
                    <th style="width:120px">Year of Study</th>
                  </tr>
                </thead>
                <tbody>
                  {% for mod in modules %}
                  {% set assigned = programme ? programme.modules.firstWhere('id', mod.id) : null %}
                  <tr>
                    <td style="text-align:center">
                      <input type="checkbox" name="module_ids[]"
                             value="{{ mod.id }}" id="mod_{{ mod.id }}"
                             {{ assigned ? 'checked' : '' }}>
                    </td>
                    <td>
                      <label for="mod_{{ mod.id }}">{{ mod.title }}</label>
                    </td>
                    <td><span class="badge badge-blue">{{ mod.code }}</span></td>
                    <td style="color:var(--muted);font-size:.82rem">{{ mod.credits }} credits</td>
                    <td>
                      <select name="module_years[{{ mod.id }}]" class="year-select">
                        {% for y in 1..6 %}
                          <option value="{{ y }}"
                            {{ (assigned and assigned.pivot.year_of_study == y) ? 'selected' : (not assigned and y == 1 ? 'selected' : '') }}>
                            Year {{ y }}
                          </option>
                        {% endfor %}
                      </select>
                    </td>
                  </tr>
                  {% endfor %}
                </tbody>
              </table>
            </div>
            <p style="font-size:.75rem;color:var(--muted);margin-top:.5rem">
              Check the modules to include and set which year of study each belongs to.
            </p>
          {% endif %}
        </div>

        <div class="form-footer">
          <button type="submit" class="btn btn-gold">
            {{ programme ? 'Save Changes' : 'Create Programme' }}
          </button>
          <a href="/university_course_portal/public/admin/programmes" class="btn btn-muted">Cancel</a>
        </div>

      </form>
    </div>
  </div>
</div>
{% endblock %}
