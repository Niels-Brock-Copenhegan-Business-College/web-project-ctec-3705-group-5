{% extends "admin/base.twig" %}
{% set page = 'dashboard' %}
{% block title %}Dashboard{% endblock %}
{% block page_title %}Dashboard{% endblock %}

{% block content %}
<div class="stat-grid">
  <div class="stat-card">
    <div class="label">Total Programmes</div>
    <div class="value">{{ totalProgrammes }}</div>
  </div>
  <div class="stat-card">
    <div class="label">Published</div>
    <div class="value" style="color:#16a34a">{{ publishedCount }}</div>
  </div>
  <div class="stat-card">
    <div class="label">Total Modules</div>
    <div class="value">{{ totalModules }}</div>
  </div>
  <div class="stat-card">
    <div class="label">Staff Members</div>
    <div class="value">{{ totalStaff }}</div>
  </div>
  <div class="stat-card">
    <div class="label">Interest Registrations</div>
    <div class="value" style="color:var(--gold)">{{ totalInterests }}</div>
  </div>
</div>

<div class="box">
  <div class="box-header">
    <h2>Recent Interest Registrations</h2>
    <a href="/university_course_portal/public/admin/mailing-list" class="btn btn-muted btn-sm">View All</a>
  </div>
  <table>
    <thead>
      <tr>
        <th>Name</th>
        <th>Email</th>
        <th>Programme</th>
        <th>Registered</th>
      </tr>
    </thead>
    <tbody>
      {% for r in recentInterests %}
      <tr>
        <td>{{ r.first_name }} {{ r.last_name }}</td>
        <td>{{ r.email }}</td>
        <td>{{ r.programme.title }}</td>
        <td>{{ r.registered_at|date('d M Y') }}</td>
      </tr>
      {% else %}
      <tr><td colspan="4" style="text-align:center;color:#94a3b8;padding:1.5rem">No registrations yet.</td></tr>
      {% endfor %}
    </tbody>
  </table>
</div>
{% endblock %}
