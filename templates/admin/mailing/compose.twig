{% extends "admin/base.twig" %}
{% set page = 'mailing' %}
{% block title %}Compose Bulk Email{% endblock %}
{% block page_title %}Send Bulk Email{% endblock %}

{% block extra_css %}
<style>
  .compose-grid { display:grid; grid-template-columns:1fr 300px; gap:1.5rem; align-items:start; }
  @media(max-width:860px){ .compose-grid { grid-template-columns:1fr; } }

  .compose-box { background:var(--white); border:1px solid var(--border); border-radius:8px; overflow:hidden; }
  .compose-box-header { padding:1rem 1.5rem; border-bottom:1px solid var(--border); background:#fafbfc; }
  .compose-box-header h2 { font-size:.8rem; font-weight:700; text-transform:uppercase; letter-spacing:.09em; color:var(--navy); }
  .compose-box-body { padding:1.5rem; }

  .recipients-card { background:var(--white); border:1px solid var(--border); border-radius:8px; overflow:hidden; }
  .recipients-card-header { padding:.85rem 1.25rem; border-bottom:1px solid var(--border); background:#fafbfc; display:flex; align-items:center; justify-content:space-between; }
  .recipients-card-header h3 { font-size:.75rem; font-weight:700; text-transform:uppercase; letter-spacing:.09em; color:var(--navy); margin:0; }
  .recipients-card-header .count { font-family:'Cormorant Garamond',serif; font-size:1.4rem; font-weight:700; color:var(--navy); }
  .recip-list { max-height:320px; overflow-y:auto; }
  .recip-item { padding:.65rem 1.25rem; border-bottom:1px solid var(--border); }
  .recip-item:last-child { border-bottom:none; }
  .recip-item strong { display:block; font-size:.82rem; color:var(--navy); }
  .recip-item span { font-size:.75rem; color:var(--muted); }

  .tip-box { background:#fffbeb; border:1px solid #fde68a; border-radius:6px; padding:.85rem 1rem; margin-bottom:1.25rem; font-size:.82rem; color:#92400e; }
  .tip-box strong { display:block; font-weight:700; margin-bottom:.35rem; font-size:.78rem; text-transform:uppercase; letter-spacing:.06em; }
  .var-chips { display:flex; gap:.4rem; flex-wrap:wrap; }
  .chip { background:var(--navy); color:var(--gold-l); font-size:.72rem; font-family:monospace; padding:.22rem .6rem; border-radius:3px; cursor:pointer; transition:opacity .15s; border:none; }
  .chip:hover { opacity:.7; }

  .warning-banner { background:#fffbeb; border:1px solid #fde68a; border-radius:6px; padding:.6rem 1rem; margin-bottom:.85rem; font-size:.8rem; color:#92400e; display:flex; align-items:center; gap:.5rem; }
  .prog-banner { background:#f0f9ff; border:1px solid #bae6fd; border-radius:6px; padding:.6rem 1rem; margin-bottom:.85rem; font-size:.8rem; color:#075985; }
</style>
{% endblock %}

{% block content %}
<div class="compose-grid">

  {# ── Compose form ── #}
  <div class="compose-box">
    <div class="compose-box-header">
      <h2>Compose Message</h2>
    </div>
    <div class="compose-box-body">

      {% if errors is defined and errors %}
        <div class="flash flash-error" role="alert">
          {% for e in errors %}<p style="margin:0">{{ e }}</p>{% endfor %}
        </div>
      {% endif %}

      <div class="tip-box">
        <strong>Personalisation Variables</strong>
        Click a variable to insert it at the cursor position in your message:
        <div class="var-chips" style="margin-top:.5rem">
          <button type="button" class="chip" onclick="insertVar('{{first_name}}')">{{first_name}}</button>
          <button type="button" class="chip" onclick="insertVar('{{last_name}}')">{{last_name}}</button>
          <button type="button" class="chip" onclick="insertVar('{{programme}}')">{{programme}}</button>
        </div>
      </div>

      <form method="post" action="/university_course_portal/public/admin/mailing-list/send-bulk" id="composeForm">
        <input type="hidden" name="programme_id" value="{{ filterProg }}">

        <div class="form-row">
          <div class="form-group">
            <label for="from_name">From Name *</label>
            <input id="from_name" type="text" name="from_name"
                   value="{{ old.from_name ?? 'University Course Portal' }}" required>
          </div>
          <div class="form-group">
            <label for="from_email">From Email *</label>
            <input id="from_email" type="email" name="from_email"
                   value="{{ old.from_email ?? 'admissions@university.ac.uk' }}" required>
          </div>
        </div>

        <div class="form-group">
          <label for="subject">Email Subject *</label>
          <input id="subject" type="text" name="subject"
                 value="{{ old.subject ?? '' }}"
                 placeholder="e.g. Open Day Invitation — BSc Computer Science" required>
        </div>

        <div class="form-group">
          <label for="message">Message Body *
            <span style="font-size:.72rem;font-weight:400;color:var(--muted);text-transform:none;letter-spacing:0">(plain text — line breaks preserved)</span>
          </label>
          <textarea id="message" name="message" rows="12"
                    placeholder="Dear {{first_name}},&#10;&#10;We are delighted to invite you to our upcoming Open Day...&#10;&#10;Kind regards,&#10;The Admissions Team" required>{{ old.message ?? '' }}</textarea>
        </div>

        <div style="display:flex;gap:.75rem;align-items:center;flex-wrap:wrap;padding-top:.5rem;border-top:1px solid var(--border);margin-top:1rem">
          <button type="submit" class="btn btn-gold"
                  onclick="return confirm('Send this email to {{ recipients|length }} recipient(s)?')">
            Send to {{ recipients|length }} Recipient{{ recipients|length != 1 ? 's' : '' }}
          </button>
          <a href="/university_course_portal/public/admin/mailing-list{{ filterProg ? '?programme_id=' ~ filterProg : '' }}"
             class="btn btn-muted">Cancel</a>
        </div>
      </form>

    </div>
  </div>

  {# ── Recipients sidebar ── #}
  <div>
    <div class="recipients-card">
      <div class="recipients-card-header">
        <h3>Recipients</h3>
        <span class="count">{{ recipients|length }}</span>
      </div>

      {% if filterProg %}
        {% set prog = programmes|filter(p => p.id == filterProg)|first %}
        <div class="prog-banner">Sending to: <strong>{{ prog.title ?? 'Selected Programme' }}</strong></div>
      {% else %}
        <div class="warning-banner">Sending to <strong>all programmes</strong></div>
      {% endif %}

      <div class="recip-list">
        {% for r in recipients %}
        <div class="recip-item">
          <strong>{{ r.first_name }} {{ r.last_name }}</strong>
          <span>{{ r.email }}</span>
          <span>{{ r.programme.title }}</span>
        </div>
        {% else %}
        <p style="color:var(--muted);font-size:.82rem;text-align:center;padding:1.5rem 0">No recipients.</p>
        {% endfor %}
      </div>
    </div>
  </div>

</div>
{% endblock %}

{% block extra_js %}
<script>
function insertVar(v) {
  const ta = document.getElementById('message');
  const start = ta.selectionStart, end = ta.selectionEnd;
  ta.value = ta.value.substring(0, start) + v + ta.value.substring(end);
  ta.selectionStart = ta.selectionEnd = start + v.length;
  ta.focus();
}
</script>
{% endblock %}