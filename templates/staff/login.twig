<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Staff Login — {{ app_name }}</title>
  <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@600;700&family=Inter:wght@400;500;600&display=swap" rel="stylesheet">
  <style>
    :root { --navy:#0b1f3a; --gold:#b8963e; --gold-l:#d4af6a; }
    *, *::before, *::after { box-sizing: border-box; margin:0; padding:0; }
    body { font-family: 'Inter', sans-serif; background: var(--navy); min-height: 100vh; display: flex; }
    .split-left {
      flex: 1;
      background: linear-gradient(160deg, #0b1f3a 0%, #1a3a5c 100%);
      display: flex;
      flex-direction: column;
      justify-content: center;
      padding: 4rem;
      border-right: 1px solid rgba(184,150,62,.2);
    }
    @media(max-width:768px){ .split-left { display:none; } }
    .split-left h1 { font-family:'Cormorant Garamond',serif;font-size:2.8rem;color:#fff;line-height:1.15;margin-bottom:1rem; }
    .split-left h1 em { color:var(--gold-l);font-style:normal; }
    .split-left p { color:rgba(255,255,255,.45);font-size:.9rem;font-weight:300;line-height:1.7;max-width:380px; }
    .split-left .divider { width:48px;height:3px;background:var(--gold);margin:1.5rem 0; }
    .split-right {
      width: 440px;
      flex-shrink: 0;
      display: flex;
      align-items: center;
      justify-content: center;
      padding: 2.5rem;
      background: #fff;
    }
    @media(max-width:768px){ .split-right { width:100%; } }
    .login-box { width:100%;max-width:360px; }
    .login-box .eyebrow { font-size:.68rem;font-weight:700;letter-spacing:.14em;text-transform:uppercase;color:var(--gold);margin-bottom:.75rem; }
    .login-box h2 { font-family:'Cormorant Garamond',serif;font-size:2rem;color:var(--navy);margin-bottom:.35rem; }
    .login-box .sub { color:#64748b;font-size:.85rem;margin-bottom:2rem;line-height:1.55; }
    .form-group { margin-bottom:1rem; }
    .form-group label { display:block;font-size:.7rem;font-weight:700;letter-spacing:.08em;text-transform:uppercase;margin-bottom:.4rem;color:var(--navy); }
    .form-group input { width:100%;padding:.65rem .9rem;border:1.5px solid #e2e6ed;border-radius:5px;font-size:.9rem;outline:none;transition:border-color .2s;font-family:inherit;color:var(--navy); }
    .form-group input:focus { border-color:var(--gold); }
    .btn { width:100%;padding:.75rem;border:none;border-radius:5px;background:var(--navy);color:var(--gold-l);font-size:.875rem;font-weight:700;cursor:pointer;margin-top:.5rem;transition:opacity .2s;letter-spacing:.04em;font-family:inherit; }
    .btn:hover { opacity:.85; }
    .error { background:#fef2f2;color:#991b1b;border:1px solid #fecaca;border-radius:5px;padding:.7rem 1rem;font-size:.82rem;margin-bottom:1rem; }
    .switch-link { text-align:center;margin-top:1.5rem;font-size:.78rem;color:#94a3b8; }
    .switch-link a { color:var(--gold);font-weight:600; }
    :focus-visible { outline:2px solid var(--gold);outline-offset:2px; }
  </style>
</head>
<body>
  <div class="split-left">
    <h1>Staff<br><em>Portal</em></h1>
    <div class="divider"></div>
    <p>View your teaching responsibilities, the modules you lead, and the programmes your modules contribute to.</p>
  </div>
  <div class="split-right">
    <div class="login-box">
      <div class="eyebrow">Staff Portal</div>
      <h2>Sign In</h2>
      <p class="sub">Enter your university email address and password to access your staff dashboard.</p>

      {% if error is defined %}
        <div class="error" role="alert">{{ error }}</div>
      {% endif %}

      <form method="post" action="/university_course_portal/public/staff/login" novalidate>
        <div class="form-group">
          <label for="email">Email Address</label>
          <input id="email" type="email" name="email" required autofocus autocomplete="email" placeholder="you@university.ac.uk">
        </div>
        <div class="form-group">
          <label for="password">Password</label>
          <input id="password" type="password" name="password" required autocomplete="current-password">
        </div>
        <button type="submit" class="btn">Sign In to Staff Portal</button>
      </form>

      <p class="switch-link">Administrator? <a href="/university_course_portal/public/admin/login">Sign in to Admin Portal</a></p>
    </div>
  </div>
</body>
</html>
