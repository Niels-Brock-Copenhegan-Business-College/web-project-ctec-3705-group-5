<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{% block title %}{{ app_name }}{% endblock %}</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@600;700&family=Inter:wght@300;400;500;600&display=swap" rel="stylesheet">
  <style>
    :root {
      --navy:   #0b1f3a;
      --navy2:  #122848;    
      --gold:   #b8963e;
      --gold-l: #d4af6a;
      --white:  #ffffff;
      --off:    #f8f7f4;
      --muted:  #6b7280;
      --border: #e4e0d8;
      --radius: 6px;
    }
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
    body { font-family: 'Inter', sans-serif; background: var(--off); color: var(--navy); font-size: 16px; line-height: 1.7; }
    a { color: var(--gold); text-decoration: none; }
    a:hover { text-decoration: underline; }

    /* NAV */
    nav {
      background: var(--navy);
      padding: 0 2.5rem;
      display: flex;
      align-items: center;
      justify-content: space-between;
      height: 68px;
      position: sticky;
      top: 0;
      z-index: 100;
      border-bottom: 3px solid var(--gold);
    }
    .nav-brand {
      font-family: 'Cormorant Garamond', serif;
      color: var(--white);
      font-size: 1.35rem;
      font-weight: 700;
      letter-spacing: .03em;
    }
    .nav-brand span { color: var(--gold-l); }
    .nav-links { display: flex; align-items: center; gap: .5rem; }
    .nav-links a.nav-link {
      color: rgba(255,255,255,.75);
      font-size: .82rem;
      font-weight: 500;
      padding: .4rem .85rem;
      border-radius: var(--radius);
      letter-spacing: .03em;
      text-transform: uppercase;
      transition: color .2s;
    }
    .nav-links a.nav-link:hover { color: var(--gold-l); text-decoration: none; }
    .nav-btn {
      font-size: .78rem;
      font-weight: 600;
      padding: .45rem 1.1rem;
      border-radius: var(--radius);
      letter-spacing: .04em;
      text-transform: uppercase;
      transition: opacity .2s;
    }
    .nav-btn:hover { opacity: .85; text-decoration: none; }
    .nav-btn-outline { border: 1.5px solid rgba(184,150,62,.5); color: var(--gold-l); }
    .nav-btn-solid   { background: var(--gold); color: var(--navy); }

    /* HERO */
    .hero {
      background: var(--navy);
      color: var(--white);
      padding: 5.5rem 2.5rem 4.5rem;
      text-align: center;
      position: relative;
      overflow: hidden;
    }
    .hero::before {
      content: '';
      position: absolute;
      inset: 0;
      background: linear-gradient(160deg, rgba(184,150,62,.08) 0%, transparent 60%);
      pointer-events: none;
    }
    .hero-eyebrow {
      display: inline-block;
      font-size: .72rem;
      font-weight: 600;
      letter-spacing: .15em;
      text-transform: uppercase;
      color: var(--gold-l);
      border: 1px solid rgba(184,150,62,.35);
      padding: .3rem 1rem;
      border-radius: 999px;
      margin-bottom: 1.25rem;
    }
    .hero h1 {
      font-family: 'Cormorant Garamond', serif;
      font-size: clamp(2.2rem, 5vw, 3.8rem);
      color: var(--white);
      margin-bottom: .75rem;
      line-height: 1.15;
    }
    .hero h1 em { color: var(--gold-l); font-style: normal; }
    .hero p { font-size: 1.05rem; opacity: .75; max-width: 580px; margin: 0 auto 2.25rem; font-weight: 300; }

    /* SEARCH */
    .search-form { margin: 0 auto; max-width: 700px; }
    .search-row {
      display: flex;
      align-items: center;
      gap: .6rem;
      flex-wrap: wrap;
      justify-content: center;
    }
    .search-row input[type=text] {
      flex: 1 1 220px;
      height: 44px;
      padding: 0 1.1rem;
      border: 1.5px solid rgba(255,255,255,.18);
      border-radius: var(--radius);
      font-size: .875rem;
      background: rgba(255,255,255,.07);
      color: var(--white);
      outline: none;
      transition: border-color .2s;
      font-family: inherit;
    }
    .search-row input[type=text]::placeholder { color: rgba(255,255,255,.4); }
    .search-row input[type=text]:focus { border-color: var(--gold); }
    .search-row select {
      height: 44px;
      padding: 0 1rem;
      border: 1.5px solid rgba(255,255,255,.18);
      border-radius: var(--radius);
      font-size: .875rem;
      background: rgba(255,255,255,.07);
      color: var(--white);
      cursor: pointer;
      font-family: inherit;
    }
    .search-row select option { background: var(--navy); }
    .search-row .btn { height: 44px; padding: 0 1.4rem; }
    .btn-outline-light {
      display: inline-flex; align-items: center;
      height: 44px; padding: 0 1.1rem;
      border: 1.5px solid rgba(255,255,255,.25);
      border-radius: var(--radius);
      color: rgba(255,255,255,.7);
      font-size: .875rem; font-weight: 600;
      text-decoration: none;
      transition: opacity .2s;
    }
    .btn-outline-light:hover { opacity: .75; text-decoration: none; }

    /* BUTTONS */
    .btn {
      display: inline-block;
      padding: .65rem 1.5rem;
      border-radius: var(--radius);
      font-weight: 600;
      font-size: .875rem;
      cursor: pointer;
      border: none;
      letter-spacing: .03em;
      transition: opacity .2s, transform .15s;
      font-family: inherit;
    }
    .btn:hover { opacity: .88; transform: translateY(-1px); text-decoration: none; }
    .btn-gold    { background: var(--gold); color: var(--white); }
    .btn-navy    { background: var(--navy); color: var(--white); }
    .btn-outline { background: transparent; border: 1.5px solid var(--gold); color: var(--gold); }
    .btn-sm      { padding: .4rem 1rem; font-size: .8rem; }
    .btn-danger  { background: #b91c1c; color: #fff; }

    /* CONTAINER */
    .container { max-width: 1180px; margin: 0 auto; padding: 0 1.75rem; }

    /* FLASH */
    .flash {
      padding: .85rem 1.4rem;
      border-radius: var(--radius);
      margin: 1.5rem auto;
      max-width: 1180px;
      font-weight: 500;
      font-size: .875rem;
    }
    .flash-success { background: #f0fdf4; color: #166534; border: 1px solid #bbf7d0; }
    .flash-error   { background: #fef2f2; color: #991b1b; border: 1px solid #fecaca; }

    /* SECTION HEADER */
    .section-header {
      display: flex;
      align-items: baseline;
      justify-content: space-between;
      padding: 2.5rem 0 1.5rem;
      border-bottom: 2px solid var(--border);
      margin-bottom: 2rem;
    }
    .section-header h2 {
      font-family: 'Cormorant Garamond', serif;
      font-size: 1.9rem;
      font-weight: 700;
      color: var(--navy);
    }
    .section-header p { color: var(--muted); font-size: .875rem; margin-top: .2rem; }

    /* CARD GRID */
    .card-grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
      gap: 1.75rem;
      padding-bottom: 3.5rem;
    }
    .card {
      background: var(--white);
      border-radius: 8px;
      border: 1px solid var(--border);
      overflow: hidden;
      display: flex;
      flex-direction: column;
      transition: transform .2s, box-shadow .2s;
    }
    .card:hover { transform: translateY(-3px); box-shadow: 0 10px 30px rgba(11,31,58,.1); }
    .card-accent { height: 4px; background: linear-gradient(90deg, var(--gold), var(--gold-l)); }
    .card-body  { padding: 1.5rem 1.6rem; flex: 1; display: flex; flex-direction: column; }
    .card-level { font-size: .7rem; font-weight: 700; text-transform: uppercase; letter-spacing: .12em; color: var(--gold); margin-bottom: .5rem; }
    .card h3    { font-family: 'Cormorant Garamond', serif; font-size: 1.3rem; font-weight: 700; margin-bottom: .6rem; color: var(--navy); line-height: 1.25; }
    .card p     { font-size: .875rem; color: var(--muted); flex: 1; margin-bottom: 1.1rem; line-height: 1.6; }
    .card-meta-row { display: flex; gap: .5rem; flex-wrap: wrap; margin-bottom: .85rem; }
    .card-footer { padding: 1rem 1.6rem; border-top: 1px solid var(--border); display: flex; align-items: center; justify-content: space-between; background: #fafaf8; }
    .card-stat   { font-size: .78rem; color: var(--muted); }

    /* PILL */
    .pill {
      display: inline-block;
      padding: .2rem .65rem;
      border-radius: 2px;
      font-size: .7rem;
      font-weight: 600;
      letter-spacing: .06em;
      text-transform: uppercase;
    }
    .pill-ug  { background: #eff6ff; color: #1e40af; border: 1px solid #bfdbfe; }
    .pill-pg  { background: #f5f3ff; color: #5b21b6; border: 1px solid #ddd6fe; }
    .pill-yr  { background: #fefce8; color: #854d0e; border: 1px solid #fde68a; }

    /* FOOTER */
    footer {
      background: var(--navy);
      border-top: 3px solid var(--gold);
      color: rgba(255,255,255,.45);
      text-align: center;
      padding: 2rem 1rem;
      font-size: .8rem;
      letter-spacing: .03em;
    }
    footer strong { color: var(--gold-l); font-weight: 500; }

    /* RESPONSIVE */
    @media (max-width: 640px) {
      nav { padding: 0 1.25rem; }
      .hero { padding: 3.5rem 1.25rem 3rem; }
    }

    /* FOCUS */
    :focus-visible { outline: 2px solid var(--gold); outline-offset: 3px; }
    .skip-link {
      position: absolute; top: -100%; left: 1rem;
      background: var(--gold); color: var(--navy);
      padding: .5rem 1rem; font-weight: 700; border-radius: 4px; z-index: 9999;
    }
    .skip-link:focus { top: .5rem; }
  </style>
  {% block extra_css %}{% endblock %}
</head>
<body>
  <a href="#main-content" class="skip-link">Skip to main content</a>

  <nav role="navigation" aria-label="Main navigation">
    <span class="nav-brand">{{ app_name }}</span>
    <div class="nav-links">
      <a href="/university_course_portal/public/" class="nav-link">Programmes</a>
      <a href="/university_course_portal/public/staff/login" class="nav-btn nav-btn-outline">Staff Portal</a>
      <a href="/university_course_portal/public/admin/login" class="nav-btn nav-btn-solid">Admin</a>
    </div>
  </nav>

  {% if session.flash_success is defined %}
    <div class="flash flash-success container" role="alert">{{ session.flash_success }}</div>
  {% endif %}

  <main id="main-content" tabindex="-1">
    {% block content %}{% endblock %}
  </main>

  <footer>
    <p>&copy; {{ "now"|date("Y") }} <strong>{{ app_name }}</strong> &mdash; All rights reserved.</p>
  </footer>

  <script>
    document.querySelectorAll('.flash').forEach(el => {
      setTimeout(() => { el.style.transition = 'opacity .5s'; el.style.opacity = '0'; }, 4000);
    });
  </script>
  {% block extra_js %}{% endblock %}
</body>
</html>
