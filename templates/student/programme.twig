{% extends "student/base.twig" %}
{% block title %}{{ programme.title }} — {{ app_name }}{% endblock %}

{% block extra_css %}
<style>
  .prog-hero { background: var(--navy); border-bottom: 3px solid var(--gold); }
  .prog-hero-inner { display:grid; grid-template-columns:1fr auto; gap:2.5rem; align-items:center; max-width:1180px; margin:0 auto; padding:3.5rem 2rem 3rem; }
  @media(max-width:700px){ .prog-hero-inner { grid-template-columns:1fr; } }
  .prog-eyebrow { font-size:.7rem;font-weight:700;letter-spacing:.15em;text-transform:uppercase;color:var(--gold-l);margin-bottom:.85rem; }
  .prog-hero h1 { font-family:'Playfair Display',serif;font-size:clamp(1.9rem,4vw,3rem);color:var(--white);margin-bottom:.75rem;line-height:1.15; }
  .prog-hero .desc { color:rgba(255,255,255,.7);max-width:680px;font-size:.95rem;margin-bottom:1.25rem; }
  .prog-hero .leader { font-size:.82rem;color:rgba(255,255,255,.5); }
  .prog-hero .leader strong { color:var(--gold-l); }
  .prog-meta-bar { display:flex;gap:.6rem;flex-wrap:wrap;margin-bottom:1.25rem; }
  .prog-hero-img { width:260px; height:180px; object-fit:cover; border-radius:12px; border:2px solid rgba(201,168,76,.3); flex-shrink:0; }

  .layout { display:grid;grid-template-columns:1fr 400px;gap:2.5rem;align-items:start;padding:2.5rem 0 4rem; }
  @media(max-width:860px){ .layout { grid-template-columns:1fr; } }

  .structure-title { font-family:'Playfair Display',serif;font-size:1.6rem;font-weight:700;margin-bottom:1.5rem;padding-bottom:.5rem;border-bottom:2px solid var(--border); }
  .year-block { margin-bottom:1.5rem;border:1px solid var(--border);border-radius:8px;overflow:hidden;background:var(--white); }
  .year-header { background:var(--navy);color:var(--white);padding:.65rem 1.25rem;font-size:.75rem;font-weight:700;letter-spacing:.1em;text-transform:uppercase; }
  .year-header span { color:var(--gold-l); }
  .module-row { display:flex;gap:1.1rem;align-items:flex-start;padding:1rem 1.25rem;border-bottom:1px solid var(--border); }
  .module-row:last-child { border-bottom:none; }
  .module-img { width:64px;height:64px;object-fit:cover;border-radius:6px;flex-shrink:0;border:1px solid var(--border); }
  .module-img-placeholder { width:64px;height:64px;background:var(--navy);border-radius:6px;flex-shrink:0;display:flex;align-items:center;justify-content:center;color:var(--gold-l);font-size:1.3rem; }
  .module-code-badge { background:var(--navy);color:var(--gold-l);font-size:.68rem;font-weight:700;letter-spacing:.06em;padding:.25rem .6rem;border-radius:3px;display:inline-block;margin-bottom:.25rem; }
  .module-info h4 { font-weight:600;font-size:.9rem;margin-bottom:.2rem;color:var(--navy); }
  .module-info p  { font-size:.8rem;color:var(--muted);margin:0;line-height:1.5; }
  .module-meta { font-size:.75rem;color:var(--muted);margin-top:.3rem;display:flex;gap:.75rem;flex-wrap:wrap; }
  .shared-tag { background:#fef3c7;color:#92400e;font-size:.68rem;font-weight:700;padding:.15rem .5rem;border-radius:999px; }

  .staff-section-title { font-family:'Playfair Display',serif;font-size:1.4rem;font-weight:700;margin:2.5rem 0 1rem;padding-bottom:.5rem;border-bottom:2px solid var(--border); }
  .staff-row { display:flex;gap:1.1rem;align-items:center;background:var(--white);border:1px solid var(--border);border-radius:8px;padding:1rem 1.25rem;margin-bottom:.75rem; }
  .staff-initial { width:44px;height:44px;border-radius:50%;background:var(--navy);color:var(--gold-l);font-family:'Playfair Display',serif;font-size:1.2rem;font-weight:700;display:flex;align-items:center;justify-content:center;flex-shrink:0; }
  .staff-detail h4 { font-weight:600;font-size:.9rem;margin-bottom:.15rem; }
  .staff-detail p  { font-size:.78rem;color:var(--muted);margin:0; }

  /* ── Sidebar ── */
  .sidebar-card {
    background: var(--white);
    border: 1px solid var(--border);
    border-radius: 10px;
    overflow: hidden;
    margin-bottom: 1.25rem;
    box-shadow: 0 4px 20px rgba(11,31,58,.08);
  }
  .sidebar-card-header {
    background: var(--navy);
    border-bottom: 3px solid var(--gold);
    padding: 1.5rem 1.75rem 1.3rem;
  }
  .sidebar-card-header h2 {
    font-family: 'Cormorant Garamond', serif;
    font-size: 1.45rem;
    color: var(--white);
    margin-bottom: .4rem;
    font-weight: 700;
    line-height: 1.2;
  }
  .sidebar-card-header p {
    color: rgba(255,255,255,.55);
    font-size: .8rem;
    line-height: 1.6;
    margin: 0;
  }
  .sidebar-card-body { padding: 1.5rem 1.75rem 1.75rem; }

  /* Stack name fields vertically — prevents overflow on long names */
  .irow { display: flex; flex-direction: column; gap: 0; }

  .ifield { display: flex; flex-direction: column; margin-bottom: 1rem; }
  .ifield label {
    font-size: .68rem;
    font-weight: 700;
    letter-spacing: .1em;
    text-transform: uppercase;
    margin-bottom: .4rem;
    color: #374151;
  }
  .ifield input {
    width: 100%;
    padding: .7rem 1rem;
    border-radius: 6px;
    border: 1.5px solid #dde1e9;
    background: #fafafa;
    color: var(--navy);
    font-size: .9rem;
    outline: none;
    transition: border-color .2s, box-shadow .2s, background .2s;
    font-family: inherit;
    box-sizing: border-box;
  }
  .ifield input:focus {
    border-color: var(--gold);
    background: var(--white);
    box-shadow: 0 0 0 3px rgba(184,150,62,.12);
  }
  .ifield input::placeholder { color: #b0b8c8; font-style: italic; }

  .errors {
    background: #fef2f2;
    border: 1px solid #fecaca;
    border-radius: 6px;
    padding: .75rem 1rem;
    margin-bottom: 1rem;
  }
  .errors li { list-style: disc inside; font-size: .82rem; color: #991b1b; }

  .register-btn {
    width: 100%;
    padding: .85rem 1rem;
    background: var(--gold);
    color: var(--white);
    border: none;
    border-radius: 6px;
    font-size: .9rem;
    font-weight: 700;
    cursor: pointer;
    letter-spacing: .05em;
    text-transform: uppercase;
    transition: background .2s, transform .15s, box-shadow .2s;
    font-family: inherit;
    margin-top: .5rem;
    box-shadow: 0 2px 8px rgba(184,150,62,.3);
  }
  .register-btn:hover {
    background: #a07c30;
    transform: translateY(-1px);
    box-shadow: 0 4px 14px rgba(184,150,62,.4);
  }

  .back-link {
    display: block;
    text-align: center;
    font-size: .78rem;
    color: var(--muted);
    margin-top: 1rem;
    text-decoration: none;
    transition: color .2s;
    letter-spacing: .02em;
  }
  .back-link:hover { color: var(--navy); text-decoration: underline; }

  /* Divider */
  .sidebar-divider {
    border: none;
    border-top: 1px solid var(--border);
    margin: 1.5rem 0 1.25rem;
  }

  /* Withdraw card */
  .withdraw-card {
    background: var(--white);
    border: 1px solid var(--border);
    border-radius: 10px;
    overflow: hidden;
    margin-bottom: 1rem;
    box-shadow: 0 4px 20px rgba(11,31,58,.08);
  }
  .withdraw-card-header {
    padding: 1rem 1.75rem;
    border-bottom: 1px solid var(--border);
    background: #fafbfc;
  }
  .withdraw-card-header h3 {
    font-size: .8rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: .1em;
    color: var(--navy);
    margin: 0;
  }
  .withdraw-card-body {
    padding: 1.25rem 1.75rem 1.5rem;
  }
  .withdraw-card-body p {
    font-size: .82rem;
    color: var(--muted);
    margin-bottom: 1rem;
    line-height: 1.6;
  }
  .withdraw-btn {
    width: 100%;
    padding: .75rem 1rem;
    background: #b91c1c;
    color: #fff;
    border: none;
    border-radius: 6px;
    font-size: .82rem;
    font-weight: 700;
    cursor: pointer;
    letter-spacing: .04em;
    text-transform: uppercase;
    font-family: inherit;
    margin-top: .5rem;
    transition: background .2s;
  }
  .withdraw-btn:hover { background: #991b1b; }
</style>
{% endblock %}

{% block content %}

{# ── Hero ── #}
<div class="prog-hero">
  <div class="prog-hero-inner">
    <div>
      <div class="prog-eyebrow">{{ programme.level }} Programme</div>
      <div class="prog-meta-bar">
        <span class="pill {{ programme.level == 'Undergraduate' ? 'pill-ug' : 'pill-pg' }}">{{ programme.level }}</span>
        <span class="pill pill-yr">{{ programme.duration_years }} Year{{ programme.duration_years > 1 ? 's' : '' }}</span>
      </div>
      <h1>{{ programme.title }}</h1>
      <p class="desc">{{ programme.description }}</p>
      {% if programme.leader %}
        <p class="leader">Programme Leader: <strong>{{ programme.leader.name }}</strong></p>
      {% endif %}
    </div>
    {% if programme.image %}
      <img class="prog-hero-img"
           src="/university_course_portal/public/uploads/programmes/{{ programme.image }}"
           alt="{{ programme.title }}">
    {% endif %}
  </div>
</div>

<div class="container">
  <div class="layout">

    {# ── Left: structure + staff ── #}
    <div>
      <h2 class="structure-title">Programme Structure</h2>

      {% if byYear|length == 0 %}
        <p style="color:var(--muted)">No modules have been assigned to this programme yet.</p>
      {% endif %}

      {% for year, mods in byYear %}
      <div class="year-block">
        <div class="year-header">Year <span>{{ year }}</span></div>
        {% for mod in mods %}
        <div class="module-row">
          {# Module image or placeholder #}
          {% if mod.image %}
            <img class="module-img"
                 src="/university_course_portal/public/uploads/modules/{{ mod.image }}"
                 alt="{{ mod.title }}">
          {% else %}
            <div class="module-img-placeholder" aria-hidden="true">📘</div>
          {% endif %}

          <div class="module-info" style="flex:1">
            <span class="module-code-badge">{{ mod.code }}</span>
            <h4>{{ mod.title }}</h4>
            {% if mod.description %}<p>{{ mod.description }}</p>{% endif %}
            <div class="module-meta">
              <span>{{ mod.credits }} credits</span>
              {% if mod.leader %}<span>Led by <strong>{{ mod.leader.name }}</strong></span>{% endif %}
              {# Shared across programmes indicator #}
              {% if mod.programmes|length > 1 %}
                <span class="shared-tag" title="This module is taught in {{ mod.programmes|length }} programmes">
                  Shared across {{ mod.programmes|length }} programmes
                </span>
              {% endif %}
            </div>
          </div>
        </div>
        {% endfor %}
      </div>
      {% endfor %}

      {# ── Staff ── #}
      {% if programme.leader %}
      <h2 class="staff-section-title">Programme Staff</h2>
      <div class="staff-row">
        <div class="staff-initial">{{ programme.leader.name|slice(0,1) }}</div>
        <div class="staff-detail">
          <h4>{{ programme.leader.name }}</h4>
          <p>Programme Leader &mdash; {{ programme.leader.email }}</p>
          {% if programme.leader.bio %}<p style="margin-top:.25rem">{{ programme.leader.bio }}</p>{% endif %}
        </div>
      </div>
      {% endif %}
    </div>

    {# ── Sidebar ── #}
    <aside style="position:sticky;top:80px;">

      {# Register interest #}
      <div class="sidebar-card" aria-labelledby="reg-heading">
        <div class="sidebar-card-header">
          <h2 id="reg-heading">Register Your Interest</h2>
          <p>Complete the form below and our admissions team will keep you informed about upcoming open days, entry requirements and application deadlines.</p>
        </div>
        <div class="sidebar-card-body">

          {% if errors is defined and errors %}
            <ul class="errors" role="alert">
              {% for e in errors %}<li>{{ e }}</li>{% endfor %}
            </ul>
          {% endif %}

          <form method="post" action="/university_course_portal/public/programmes/{{ programme.slug }}/register" novalidate>
            <div class="irow">
              <div class="ifield">
                <label for="first_name">First Name *</label>
                <input id="first_name" type="text" name="first_name" value="{{ old.first_name ?? '' }}" required autocomplete="given-name" placeholder="e.g. Jane">
              </div>
              <div class="ifield">
                <label for="last_name">Last Name *</label>
                <input id="last_name" type="text" name="last_name" value="{{ old.last_name ?? '' }}" required autocomplete="family-name" placeholder="e.g. Smith">
              </div>
            </div>
            <div class="ifield">
              <label for="reg_email">Email Address *</label>
              <input id="reg_email" type="email" name="email" value="{{ old.email ?? '' }}" required autocomplete="email" placeholder="e.g. jane.smith@email.com">
            </div>
            <div class="ifield">
              <label for="phone">Contact Number <span style="font-weight:400;text-transform:none;letter-spacing:0;font-size:.68rem;color:var(--muted)">(optional)</span></label>
              <input id="phone" type="tel" name="phone" value="{{ old.phone ?? '' }}" autocomplete="tel" placeholder="Optional">
            </div>
            <button type="submit" class="register-btn">Submit Registration</button>
          </form>

          <a href="/university_course_portal/public/" class="back-link">← Return to All Programmes</a>
        </div>
      </div>

      {# Withdraw interest #}
      <div class="withdraw-card">
        <div class="withdraw-card-header">
          <h3>Withdraw Registration</h3>
        </div>
        <div class="withdraw-card-body">
          <p>If you no longer wish to receive updates about this programme, enter your email address below to remove your registration.</p>
          <form method="post" action="/university_course_portal/public/interest/withdraw" novalidate>
            <input type="hidden" name="programme_id" value="{{ programme.id }}">
            <div class="ifield">
              <label for="withdraw_email">Email Address</label>
              <input id="withdraw_email" type="email" name="email"
                     placeholder="e.g. jane.smith@email.com" required>
            </div>
            <button type="submit" class="withdraw-btn"
                    onclick="return confirm('Are you sure you wish to withdraw your interest in this programme?')">
              Withdraw Registration
            </button>
          </form>
        </div>
      </div>

    </aside>
  </div>
</div>
{% endblock %}