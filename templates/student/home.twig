{% extends "student/base.twig" %}
{% block title %}Explore Programmes — {{ app_name }}{% endblock %}

{% block content %}
<section class="hero">
  <h1>Discover Your Future</h1>
  <p>Explore undergraduate and postgraduate programmes and register your interest today.</p>

  <form class="search-form" method="get" action="/university_course_portal/public/" role="search">
    <div class="search-row">
      <input id="search" type="text" name="search" value="{{ search }}" placeholder="Search programmes...">
      <select id="level" name="level">
        <option value="">All Levels</option>
        <option value="Undergraduate" {% if level == 'Undergraduate' %}selected{% endif %}>Undergraduate</option>
        <option value="Postgraduate"  {% if level == 'Postgraduate'  %}selected{% endif %}>Postgraduate</option>
      </select>
      <button type="submit" class="btn btn-gold">Search</button>
      {% if search or level %}
        <a href="/university_course_portal/public/" class="btn btn-outline-light">Clear</a>
      {% endif %}
    </div>
  </form>
</section>

<div class="container">
  {% if programmes|length == 0 %}
    <p style="padding:3rem 0;text-align:center;color:var(--muted)">No programmes found. Try a different search.</p>
  {% else %}
    <p style="padding-top:1.5rem;color:var(--muted);font-size:.9rem">
      Showing <strong>{{ programmes|length }}</strong> programme{{ programmes|length != 1 ? 's' : '' }}
    </p>
    <div class="card-grid" role="list">
      {% for prog in programmes %}
      <article class="card" role="listitem">
        {% if prog.image %}
          <img src="/university_course_portal/public/{{ prog.image }}"
               alt="{{ prog.title }}"
               style="width:100%;height:180px;object-fit:cover;">
        {% else %}
          <div style="width:100%;height:180px;background:linear-gradient(135deg,var(--navy) 0%,#1a3256 100%);display:flex;align-items:center;justify-content:center;">
            <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="rgba(184,150,62,.5)" stroke-width="1.5"><path d="M22 10v6M2 10l10-5 10 5-10 5z"/><path d="M6 12v5c3 3 9 3 12 0v-5"/></svg>
          </div>
        {% endif %}

        <div class="card-body">
          <span class="card-tag">{{ prog.level }}</span>
          <h3>{{ prog.title }}</h3>
          <p>{{ prog.description|slice(0,120) ~ (prog.description|length > 120 ? '…' : '') }}</p>
          <div style="display:flex;gap:.5rem;flex-wrap:wrap;margin-bottom:.5rem">
            <span class="pill {{ prog.level == 'Undergraduate' ? 'pill-ug' : 'pill-pg' }}">{{ prog.level }}</span>
            <span class="pill pill-yr">{{ prog.duration_years }} Year{{ prog.duration_years > 1 ? 's' : '' }}</span>
          </div>
          {% if prog.leader %}
            <p style="font-size:.82rem;color:var(--muted)">Led by {{ prog.leader.name }}</p>
          {% endif %}
        </div>

        <div class="card-footer">
          <span class="card-meta">{{ prog.modules.count() }} modules</span>
          <a href="/university_course_portal/public/programmes/{{ prog.slug }}" class="btn btn-gold btn-sm">View Programme</a>
        </div>
      </article>
      {% endfor %}
    </div>
  {% endif %}
</div>
{% endblock %}